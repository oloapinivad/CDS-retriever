######## -----   USER CONFIGURATION ------- ########

tmpdir : '/scratch/b/b382076/era5'    # download folder
storedir : '/work/bb1153/b382076/ERA5'   # store folder

dataset : 'ERA5'    # Available options: 'ERA5', 'ERA5-Land'
product_type : 'reanalysis'    # 'reanalysis' (default) or the ERA5 ensemble: 'ensemble_members',
                               # 'ensemble_mean', 'ensemble_spread' (3-hourly, use freq 3hrs or 6hrs)
varlist: ['top_net_solar_radiation', 'top_net_thermal_radiation', 'total_precipitation']    # Variables must share the same properties!
year :
  begin : 1940
  end : 2022
  update : False    # Option to extend current dataset. This will supersede the begin/end values

freq : 'mon'    # Data frequency. Available options: 'instant', '1hr', '3hrs', '6hrs', 'mon'.
                # Beware of 'instant' (first hour of each month). 'mon' gets monthly means.
levelout : 'sfc'    # Vertical levels. Available option: 'sfc', 'plev37', 'plev19', 'plev8',
                    # a single pressure level (e.g. '500hPa') or a list (e.g. ['500hPa', '850hPa']).
grid : 'full'    # Grid selection. Available options: 'full', '0.1x0.1', '0.25x0.25', '0.5x0.5', '1x1', '2.5x2.5'.
                 # 'full' = no choice is made, i.e. the original grid is provided
area : 'global'    # Either 'global' or a list of coordinates in the North, West, South, East order (e.g. [65, -15, 25, 45])

nprocs : 10    # Number of parallel processes (years retrieved at the same time)

download_request : 'auto'    # 'auto': yearly requests if within the CDS size limit, otherwise monthly.
                             # 'yearly' or 'monthly' to force the chunk size.
retries : 3    # Number of attempts for each request
check_request : True    # Validate the request against the CDS catalogue before downloading

#### - control for the structure --- ###
do_retrieve : True    # Retrieve data from CDS
do_postproc : True    # Postproc data with CDO
do_align : True    # Set equal time axis to monthly data to work with Xarray
